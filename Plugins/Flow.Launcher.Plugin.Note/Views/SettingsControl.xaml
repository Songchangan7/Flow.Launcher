<UserControl
    x:Class="Flow.Launcher.Plugin.Note.Views.SettingsControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    MinWidth="420">
    <StackPanel Margin="12">
        <TextBlock
            Margin="0,0,0,8"
            FontSize="16"
            FontWeight="SemiBold"
            Text="Quick Note" />
        <TextBlock
            Margin="0,0,0,6"
            Text="笔记保存文件路径" />
        <TextBox
            Margin="0,0,0,8"
            Text="{Binding NotesFilePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        <TextBlock
            Margin="0,0,0,8"
            Foreground="Gray"
            Text="留空时默认保存到 Flow Launcher 用户数据目录中的 notes.json；也可以填写自定义绝对路径，支持环境变量。"
            TextWrapping="Wrap" />
        <TextBlock
            Margin="0,0,0,12"
            Foreground="Gray"
            Text="{Binding ActivePathText}"
            TextWrapping="Wrap" />
        <Button
            Width="120"
            HorizontalAlignment="Left"
            Click="SaveButton_OnClick"
            Content="保存并应用" />
    </StackPanel>
</UserControl>
